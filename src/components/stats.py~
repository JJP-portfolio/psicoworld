class Stats:

    def __init__(self, hp=100, attack=10, magic=5, speed=5):
        self.max_hp = hp
        self.hp = hp
        self.attack = attack
        self.magic = magic
        self.speed = speed
        self.level = 1
        self.exp = 0

    def take_damage(self, amount):
        self.hp -= amount
        if self.hp < 0:
            self.hp = 0

    def heal(self, amount):
        self.hp += amount
        if self.hp > self.max_hp:
            self.hp = self.max_hp

    def is_alive(self):
        return self.hp > 0

    def gain_exp(self, amount):
        self.exp += amout
        if self.exp >= self.level * 100:
            self.level_up()

    def level_up(self):
        self.level += 1
        self.max_hp += 10
        self.hp = self.max_hp
        self.attack += 2
        self.magic += 1
        self.speed += 1
        self.exp = 0
        
