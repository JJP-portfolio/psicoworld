import pygame
from src.states.state_machine import State       # La clase base State. O sea los estados.
from src.settings import WHITE, BLACK, RED, SCREEN_WIDTH, SCREEN_HEIGHT # Las constantes.

class MenuState(State):                 # Esto se hereda de State (Que podemos decir es una caja que hace cosas).

    def enter(self):                    # Con self definimos que se ejecuta cuando entramos al menut
        self.title_font = pygame.font.Font("assets/fonts/diablo.ttf", 64)
        self.option_font = pygame.font.Font("assets/fonts/diablo.ttf", 32)
        self.selected = 0               # Inicializamos la variable en 0.
        self.options = ["Iniciar Juego", "Salir"]   # Las opciones del menú, podriamos agregar "Opciones", "Creditos", Apartado de "Arte".

    def handle_events(self, events):    # Esta es la funcion que revisa que apreto el usuario.
        for event in events:            # Este for revisa el evento dentro de los eventos.
            if event.type == pygame.KEYDOWN:  # Si (if), apreto una tecla
                if event.key == pygame.K_DOWN: # Anidamos pq aca se bifurca la decision, en este caso, lo primero que evalua es si el usuario apreto la tecla(KEY O K), _DOWN, que es la tecla de la flecha hacia abajo, puede no ser la flecha en si del teclado si no una tecla asignada.
                    self.selected = (self.selected + 1) % len(self.options) # Baja la seleccion.
                elif event.key == pygame.K_UP: # Lo mismo, evalua en este caso Arriba.
                    self.selected = (self.selected -1) % len(self.options) # Sube la seleccion.
                elif event.key == pygame.K_RETURN: # Enter
                    if self.selected == 0: # Si eligio "Iniciar Juego"
                        self.game.state_machine.change("character_creation") # Cambia a creacion de personaje.
                    elif self.selected == 1: # Si eligio "Salir"
                        pygame.event.post(pygame.event.Event(pygame.QUIT)) # Cierra el Juego.
    def render(self, screen): # Dibuja el menú en pantalla
        screen.fill(BLACK) # Turururu Paint IN BLACK

        title = self.title_font.render("Porro Adventures", True, RED) # Crea el texto del titulo.
        title_rect = title.get_rect(center=(SCREEN_WIDTH // 2, 200)) # Lo centra en la pantalla.
        screen.blit(title, title_rect) # Con esta funcion de pygames (blit, BLock Image Transfer) podemos dibujar el centrado en la pantalla. Es como un print, pero "renderizado".
        for i, option in enumerate(self.options): # Con este for recorremos las opciones.
            color = WHITE if i == self.selected else (100, 100, 100) # Si esta seleccionada, blanco
            text = self.option_font.render(option, True, color) # Crea el texto
            text_rect = text.get_rect(center=(SCREEN_WIDTH // 2, 400 + i * 60)) # Lo posiciona
            screen.blit(text, text_rect) # Lo dibuja, con la funcion explicada anteriormente
        
